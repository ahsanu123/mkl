	)
	(text_box "BQ24075RGT is DPPM or Dynamic Power Path Management, \nit will automatically \"route\" VBus to OUT or if battery \navailable and VBus not available, it will route VBat to \nOUT, it also automatically charging the battery if VBus \navailable, it got small indicator if power, is in good \ncondition, also indicator for charging when battery \ncurrently in charging state."
		(exclude_from_sim no)
		(at 85.09 128.27 0)
		(size 63.5 16.2161)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2c5f01d0-5ff3-464d-a03b-9f5c39ab157b")
	)
